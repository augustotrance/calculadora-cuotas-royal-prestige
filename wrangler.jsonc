{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calculadora-cuotas-royal-prestige",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
